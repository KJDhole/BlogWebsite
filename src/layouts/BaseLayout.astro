---
import '../styles/global.css'
import '../styles/signal-ledger.css'
import '../styles/reading.css'
import SearchOverlay from '../components/SearchOverlay.astro'
import { SITE } from '../config/site.mjs'

const defaultCanonical = new URL(Astro.url.pathname, SITE.url).href
const {
  title = SITE.title,
  description = SITE.description,
  canonical = defaultCanonical,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd
} = Astro.props

const resolvedImage = ogImage ? new URL(ogImage, SITE.url).href : undefined
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.language,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    sameAs: [SITE.github, SITE.x]
  }
}
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || 'https://cloud.umami.is/script.js'
---
<!doctype html>
<html lang={SITE.language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#f2efe8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171715" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Glenn RSS" href={new URL('/rss.xml', SITE.url).href} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {resolvedImage && <meta property="og:image" content={resolvedImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={resolvedImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd ?? defaultJsonLd)}></script>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('glenn-blog-theme')
          const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : preferred
        } catch {}
      })()
    </script>
    {umamiWebsiteId && <script async defer is:inline data-website-id={umamiWebsiteId} src={umamiScriptUrl}></script>}
  </head>
  <body>
    <slot />
    <SearchOverlay />
    <script>
      import '../scripts/siteShell.js'
    </script>
  </body>
</html>
