---
import BaseLayout from './BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SignalFooter from '../components/SignalFooter.astro'
import { SITE } from '../config/site.mjs'
import { slugifyTag } from '../lib/slug.mjs'

const { post, readTime, headings = [], previousPost = null, nextPost = null } = Astro.props
const { title, description, date, updated, category, tags, cover, sourceUrl, sourceLabel } = post.data
const formatDate = value => value.toLocaleDateString('en-GB', {
  year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC'
}).toUpperCase()
const dateLabel = formatDate(date)
const updatedLabel = updated ? formatDate(updated) : null
const canonical = new URL(Astro.url.pathname, SITE.url).href
const tocItems = headings.filter(heading => heading.depth === 2 || heading.depth === 3)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  mainEntityOfPage: canonical,
  inLanguage: SITE.language,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    sameAs: [SITE.github, SITE.x]
  },
  publisher: { '@type': 'Person', name: SITE.author },
  keywords: tags.join(', ')
}
---
<BaseLayout
  title={`${title} — Glenn`}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  ogImage={cover}
  publishedTime={date.toISOString()}
  modifiedTime={(updated ?? date).toISOString()}
  jsonLd={articleSchema}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <SiteHeader active="article" />

  <main class="signal-article">
    <header class="article-opening">
      <div class="article-opening__register" aria-hidden="true"><span>NOTE</span><i></i></div>
      <div class="article-opening__main">
        <p class="signal-kicker">{category} / WRITING</p>
        <h1>{title}</h1>
        <p class="article-dek">{description}</p>
        <nav class="article-page-tags" aria-label="文章标签">
          {tags.map((tag, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
            </>
          ))}
        </nav>
      </div>
    </header>

    {cover && (
      <figure class="article-cover media-wide">
        <img src={cover} alt="" loading="eager" decoding="async" />
      </figure>
    )}

    {tocItems.length > 0 && (
      <details class="article-toc article-toc-mobile">
        <summary>Contents <span>{tocItems.length}</span></summary>
        <ol>
          {tocItems.map(heading => (
            <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </details>
    )}

    <div class={`article-frame ${tocItems.length === 0 ? 'without-toc' : ''}`}>
      <aside class="article-meta-rail" aria-label="文章信息">
        <div class="article-meta-rail__signal" aria-hidden="true"><span></span></div>
        <dl>
          <div><dt>Published</dt><dd><time datetime={date.toISOString()}>{dateLabel}</time></dd></div>
          <div><dt>Reading</dt><dd>{readTime} MIN</dd></div>
          {updatedLabel && <div><dt>Updated</dt><dd><time datetime={updated.toISOString()}>{updatedLabel}</time></dd></div>}
          {sourceUrl && <div><dt>灵感来源</dt><dd><a href={sourceUrl} target="_blank" rel="noreferrer">{sourceLabel ?? 'Source ↗'}</a></dd></div>}
        </dl>
      </aside>

      <article class="article-body"><slot /></article>

      {tocItems.length > 0 && (
        <aside class="article-toc article-context-rail" aria-label="文章目录">
          <p>CONTENTS</p>
          <ol>
            {tocItems.map(heading => (
              <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    <footer class="article-end">
      {(previousPost || nextPost) && (
        <nav class="article-pagination" aria-label="文章翻页">
          {previousPost ? (
            <a href={`/writing/${previousPost.id}/`} rel="prev"><span>PREVIOUS</span><strong>{previousPost.data.title}</strong></a>
          ) : <span></span>}
          {nextPost ? (
            <a href={`/writing/${nextPost.id}/`} rel="next"><span>NEXT</span><strong>{nextPost.data.title}</strong></a>
          ) : <span></span>}
        </nav>
      )}
      <div class="article-end-links">
        <a href="/">← Back to home</a>
        <a href="/archive/">Archive</a>
      </div>
    </footer>
  </main>

  <SignalFooter />

  <script>
    import '../scripts/articleEnhance.js'
  </script>
</BaseLayout>
