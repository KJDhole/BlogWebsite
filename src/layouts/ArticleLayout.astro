---
import BaseLayout from './BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE } from '../config/site.mjs'
import { slugifyTag } from '../lib/slug.mjs'

const { post, readTime, headings = [], previousPost = null, nextPost = null } = Astro.props
const { title, description, date, updated, category, tags, cover, sourceUrl, sourceLabel } = post.data
const dateLabel = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit'
}).toUpperCase()
const canonical = new URL(Astro.url.pathname, SITE.url).href
const tocItems = headings.filter(heading => heading.depth === 2 || heading.depth === 3)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  mainEntityOfPage: canonical,
  inLanguage: SITE.language,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    sameAs: [SITE.github, SITE.x]
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author
  },
  keywords: tags.join(', ')
}
---
<BaseLayout
  title={`${title} — Glenn`}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  ogImage={cover}
  publishedTime={date.toISOString()}
  modifiedTime={(updated ?? date).toISOString()}
  jsonLd={articleSchema}
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <div class="article-page-shell">
    <SiteHeader className="article-topbar" />

    <main class="article-page">
      <header class="article-header">
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <p class="article-dek">{description}</p>
        <div class="article-page-meta">
          <time datetime={date.toISOString()}>{dateLabel}</time>
          <span aria-hidden="true">·</span>
          <span>{readTime} MIN READ</span>
        </div>
        <nav class="article-page-tags" aria-label="文章标签">
          {tags.map((tag, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
            </>
          ))}
        </nav>
      </header>

      {cover && <img class="article-cover media-wide" src={cover} alt="" loading="eager" decoding="async" />}

      {tocItems.length > 0 && (
        <details class="article-toc article-toc-mobile">
          <summary>目录 <span>{tocItems.length}</span></summary>
          <ol>
            {tocItems.map(heading => (
              <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <div class={`article-reading-grid ${tocItems.length === 0 ? 'without-toc' : ''}`}>
        <article class="article-body"><slot /></article>
        {tocItems.length > 0 && (
          <aside class="article-toc article-toc-desktop" aria-label="文章目录">
            <p>CONTENTS</p>
            <ol>
              {tocItems.map(heading => (
                <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </aside>
        )}
      </div>

      <footer class="article-end">
        {sourceUrl && (
          <p class="article-source">灵感来源：<a href={sourceUrl} target="_blank" rel="noreferrer">{sourceLabel ?? sourceUrl}</a></p>
        )}
        {(previousPost || nextPost) && (
          <nav class="article-pagination" aria-label="文章翻页">
            {previousPost ? <a href={`/writing/${previousPost.id}/`}><span>PREVIOUS</span>{previousPost.data.title}</a> : <span></span>}
            {nextPost ? <a href={`/writing/${nextPost.id}/`}><span>NEXT</span>{nextPost.data.title}</a> : <span></span>}
          </nav>
        )}
        <div class="article-end-links">
          <a class="article-back" href="/">← Back to home</a>
          <a class="article-back" href="/archive/">Archive</a>
        </div>
      </footer>
    </main>
  </div>

  <script>
    import '../scripts/articleEnhance.js'
  </script>
</BaseLayout>
