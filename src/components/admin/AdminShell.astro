---
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/admin.css'

const {
  title = '写作后台',
  subtitle = '写作、保存、发布。',
  showLogout = true
} = Astro.props
---
<BaseLayout
  title={`${title} · Glenn 写作后台`}
  description="Glenn Blog 私人写作后台。"
  noindex={true}
>
  <main class="admin-app">
    <header class="admin-topbar">
      <a class="admin-brand" href="/admin/" aria-label="返回写作后台">
        <span class="brand-dot" aria-hidden="true"></span>
        GLENN / 写作后台
      </a>
      <div class="admin-topbar-actions">
        <a class="admin-text-link" href="/">查看博客</a>
        {showLogout && <button class="admin-ghost-button" type="button" data-logout>退出</button>}
      </div>
    </header>
    <section class="admin-heading">
      <p class="admin-kicker">私人写作空间</p>
      <h1>{title}</h1>
      <p>{subtitle}</p>
    </section>
    <slot />
  </main>
</BaseLayout>
<script>
  import { apiFetch } from '../../scripts/admin/api'
  const logout = document.querySelector<HTMLElement>('[data-logout]')
  logout?.addEventListener('click', async () => {
    logout.setAttribute('aria-busy', 'true')
    try {
      await apiFetch('/auth/logout', { method: 'POST' })
    } finally {
      window.location.replace('/admin/login/')
    }
  })
</script>
