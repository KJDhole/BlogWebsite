---
import { getCollection } from 'astro:content'
import ArticleRow from '../components/ArticleRow.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { estimateReadingTime } from '../lib/readingTime.mjs'

const posts = (await getCollection('posts', ({ data }) => import.meta.env.PROD ? data.draft !== true : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---
<BaseLayout>
  <span class="flight-echo flight-echo-two" aria-hidden="true"></span>
  <span class="flight-echo flight-echo-one" aria-hidden="true"></span>
  <span class="flight-orb" aria-hidden="true"></span>

  <div class="page-shell">
    <header class="site-topbar">
      <a class="brand" href="#top" aria-label="返回首页">GLENN<span class="brand-dot" aria-hidden="true"></span></a>
      <button id="theme-toggle" class="icon-button theme-toggle" type="button" aria-label="切换深浅主题" title="切换主题">
        <span class="theme-icon theme-icon-sun" aria-hidden="true">☼</span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true">◐</span>
      </button>
    </header>

    <main id="top">
      <section class="hero reveal-block" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">PERSONAL NOTES · 2026</p>
          <h1 id="hero-title">Hi, I’m Glenn.</h1>
          <p class="hero-intro">CS student exploring <strong>AI</strong>, <strong>Agents</strong>, and building things that matter.</p>
          <div class="social-row" aria-label="社交链接">
            <a href="https://x.com" target="_blank" rel="noreferrer" aria-label="X / Twitter" class="social-link">X</a>
            <a href="https://github.com/KJDhole" target="_blank" rel="noreferrer" aria-label="GitHub" class="social-link">GH</a>
            <a href="mailto:hello@example.com" aria-label="Email" class="social-link">↗</a>
          </div>
        </div>

        <div class="orbit-wrap" aria-hidden="true">
          <div class="orbit-stage">
            <svg class="orbit-svg" viewBox="0 0 420 420" focusable="false">
              <g class="orbit-grid">
                <line class="orbit-grid-line" x1="-22" y1="210" x2="442" y2="210"></line>
                <line class="orbit-grid-line" x1="210" y1="-22" x2="210" y2="442"></line>
              </g>
              <g class="orbit-geometry">
                <circle class="orbit-ring orbit-ring-a" cx="210" cy="210" r="70"></circle>
                <circle class="orbit-ring orbit-ring-b" cx="210" cy="210" r="120"></circle>
                <circle class="orbit-ring orbit-ring-c-base" cx="210" cy="210" r="172"></circle>
                <circle class="orbit-ring orbit-ring-c" cx="210" cy="210" r="172" pathLength="1"></circle>
              </g>
              <g class="orbit-planets">
                <circle class="orbit-planet orbit-planet-a" cx="280" cy="210" r="4"></circle>
                <circle class="orbit-planet orbit-planet-b" cx="90" cy="210" r="4.5"></circle>
                <circle class="orbit-planet orbit-planet-c" cx="382" cy="210" r="7"></circle>
              </g>
              <circle class="orbit-core-halo" cx="210" cy="210" r="19"></circle>
              <circle class="orbit-core" cx="210" cy="210" r="9"></circle>
            </svg>
          </div>
          <p class="orbit-caption">slow systems · clear thinking</p>
        </div>
      </section>

      <section class="content-section" aria-label="文章">
        <div class="controls reveal-block">
          <label class="search-box" for="article-search">
            <span class="search-icon" aria-hidden="true">⌕</span>
            <input id="article-search" type="search" autocomplete="off" placeholder="Search articles…" aria-label="搜索文章" />
            <kbd>⌘ K</kbd>
          </label>

          <div class="filter-wrap" aria-label="文章分类">
            <div class="filter-list" role="tablist" aria-label="文章分类筛选">
              <button class="filter-button is-active" type="button" role="tab" aria-selected="true" data-category="All">All</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="AI">AI</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Agent">Agent</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Development">Development</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Product">Product</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Thinking">Thinking</button>
              <span class="filter-indicator" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="section-heading reveal-block">
          <div>
            <p class="eyebrow">LATEST WRITING</p>
            <h2>Articles</h2>
          </div>
          <p id="result-count" class="result-count" aria-live="polite"></p>
        </div>

        <div id="article-list" class="article-list" aria-live="polite">
          {posts.map(post => <ArticleRow post={post} readTime={estimateReadingTime(post.body ?? '')} />)}
        </div>
        <div id="empty-state" class="empty-state" hidden>
          <p>No matching articles.</p>
          <button id="clear-filters" type="button">Clear filters</button>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand brand-small" href="#top">GLENN<span class="brand-dot" aria-hidden="true"></span></a>
      <div class="footer-meta">
        <span>© 2026 Glenn</span>
        <span>Building in public.</span>
      </div>
    </footer>
  </div>

  <script>
    import '../scripts/home.js'
  </script>
</BaseLayout>
