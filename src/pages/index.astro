---
import { getCollection } from 'astro:content'
import ArticleRow from '../components/ArticleRow.astro'
import SpaceScene from '../components/SpaceScene.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../config/site.mjs'
import { estimateReadingTime } from '../lib/readingTime.mjs'

const posts = (await getCollection('posts', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---
<BaseLayout title={SITE.title} description={SITE.description}>
  <div class="page-shell home-shell">
    <header class="site-topbar folio-topbar">
      <a class="brand" href="#top" aria-label="返回首页" data-world-morph="brand">GLENN<span class="brand-dot" aria-hidden="true"></span></a>
      <nav class="folio-nav" aria-label="主要导航" data-world-morph="primary-nav">
        <a href="#writing">Writing</a>
        <a href="/archive/">Archive</a>
        <a href="/tags/">Tags</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <button
        id="theme-toggle"
        class="icon-button theme-toggle"
        type="button"
        data-world-toggle
        data-world-morph="world-toggle"
        aria-label="切换到 Observatory"
        title="切换世界"
      >
        <span class="theme-icon theme-icon-sun" aria-hidden="true">☼</span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true">◐</span>
      </button>
    </header>

    <SpaceScene />

    <main id="top">
      <section class="hero cosmic-hero reveal-block" aria-labelledby="hero-title">
        <div class="hero-copy folio-intro">
          <p
            class="eyebrow world-eyebrow"
            data-world-morph="hero-eyebrow"
            data-observatory-label="GLENN / RESEARCH FOLIO / 2026"
            data-solar-label="GLENN / SOLAR ARCHIVE / 2026"
          >GLENN / RESEARCH FOLIO / 2026</p>

          <div class="solar-observation-meta" data-world-morph="observation-meta" aria-hidden="true">
            <span>OBS / SOL-26</span>
            <span>λ 617.3 NM</span>
            <span>+18.4° / 72.1°</span>
          </div>

          <h1 id="hero-title" data-world-morph="hero-title">Build things.<br />Study the systems behind them.</h1>
          <p class="hero-intro" data-world-morph="principles"><span class="folio-principles">Build · Analyze · Think</span></p>
          <p class="folio-note" data-world-morph="hero-note">关于 AI Agent、产品、工程与判断。记录我真正做过、拆过、验证过的东西。</p>
          <div class="social-row" aria-label="社交链接" data-world-morph="social-row">
            <a href={SITE.x} target="_blank" rel="noreferrer" aria-label="X / Twitter" class="social-link">X ↗</a>
            <a href={SITE.github} target="_blank" rel="noreferrer" aria-label="GitHub" class="social-link">GitHub ↗</a>
          </div>
        </div>

        <div class="orbit-wrap" aria-hidden="true" data-world-morph="scene-stage">
          <div class="scene-anchor scene-anchor-observatory" data-scene-anchor="observatory"></div>
          <div class="scene-anchor scene-anchor-solar" data-scene-anchor="solar"></div>
          <p class="orbit-caption">slow systems · clear thinking</p>
        </div>
      </section>

      <section id="writing" class="content-section publication-index" aria-label="文章索引">
        <header class="index-heading reveal-block" data-world-morph="writing-heading">
          <div>
            <p class="eyebrow">WRITING / CHRONOLOGICAL INDEX</p>
            <h2>Notes, systems,<br />and working ideas.</h2>
          </div>
          <p class="index-description">按时间整理的公开笔记。搜索标题、主题或标签，或按领域筛选。</p>
          <div class="solar-marginalia" aria-hidden="true">
            <span>HELIOGRAPH / 617.3 NM</span>
            <span>SERIES / NOTES + SYSTEMS</span>
            <span>CAT / 2026.09</span>
          </div>
        </header>

        <div class="index-tools controls reveal-block" data-world-morph="writing-tools">
          <label class="index-search" for="article-search">
            <span class="index-search-label">SEARCH</span>
            <input id="article-search" type="search" autocomplete="off" placeholder="Title, topic, tag…" aria-label="搜索文章" />
            <kbd>⌘ K</kbd>
          </label>

          <div class="filter-wrap" aria-label="文章分类">
            <div class="filter-list" role="tablist" aria-label="文章分类筛选">
              <button class="filter-button is-active" type="button" role="tab" aria-selected="true" data-category="All">All</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="AI">AI</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Agent">Agent</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Development">Development</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Product">Product</button>
              <button class="filter-button" type="button" role="tab" aria-selected="false" data-category="Thinking">Thinking</button>
              <span class="filter-indicator" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="index-register-head reveal-block" aria-hidden="true">
          <span>DATE</span>
          <span>ENTRY</span>
          <span>FIELD / READ</span>
        </div>
        <p id="result-count" class="result-count" aria-live="polite"></p>

        <div id="article-list" class="article-list publication-register" aria-live="polite">
          {posts.map((post, index) => <ArticleRow post={post} index={index} readTime={estimateReadingTime(post.body ?? '')} />)}
        </div>
        <div id="empty-state" class="empty-state" hidden>
          <p>No matching entries.</p>
          <button id="clear-filters" type="button">Clear filters</button>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand brand-small" href="#top">GLENN<span class="brand-dot" aria-hidden="true"></span></a>
      <div class="footer-meta">
        <span>© 2026 Glenn</span>
        <span>Study in public.</span>
        <span class="footer-links"><a href="/archive/">Archive</a><a href="/tags/">Tags</a><a href="/rss.xml">RSS</a></span>
      </div>
    </footer>
  </div>

  <script>
    import '../scripts/home.js'
  </script>
</BaseLayout>
