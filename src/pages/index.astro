---
import { getCollection } from 'astro:content'
import LedgerEntry from '../components/LedgerEntry.astro'
import SignalFooter from '../components/SignalFooter.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../config/site.mjs'
import { estimateReadingTime } from '../lib/readingTime.mjs'

const posts = (await getCollection('posts', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const activeTopics = [...new Set(posts.flatMap(post => [post.data.category, ...(post.data.tags ?? [])]))]
  .filter(Boolean)
---
<BaseLayout title={SITE.title} description={SITE.description}>
  <main class="signal-index-shell" data-signal-index>
    <section class="ledger-opening" aria-labelledby="ledger-opening-title">
      <div class="signal-rail signal-rail--opening" aria-hidden="true">
        <span class="signal-rail__index">00</span>
        <span class="signal-rail__locator"></span>
      </div>

      <div class="ledger-opening__copy">
        <p class="signal-kicker">GLENN / WORKING NOTES</p>
        <h1 id="ledger-opening-title">Notes on things I’m building and trying to understand.</h1>
        <p>AI、Agent、Product、Development、Systems，以及长期实验中留下的观察、判断和复盘。</p>
      </div>

      <aside class="ledger-opening__scope" aria-label="当前内容主题与工具">
        <span>INDEXED TOPICS</span>
        <p>{activeTopics.length ? activeTopics.join(' / ') : 'Writing'}</p>
        <p><button class="signal-text-button" type="button" data-search-open>Search / ⌘K</button></p>
        <p><button class="signal-text-button" type="button" data-theme-toggle>Theme / ◐</button></p>
      </aside>
    </section>

    <section class="writing-ledger" id="writing" aria-labelledby="writing-title">
      <header class="ledger-section-head">
        <div class="signal-rail signal-rail--section" aria-hidden="true">
          <span class="signal-rail__index">01</span>
          <span class="signal-rail__locator"></span>
        </div>
        <div>
          <p class="signal-kicker">CHRONOLOGICAL INDEX</p>
          <h2 id="writing-title">Writing</h2>
        </div>
        <p>{String(posts.length).padStart(2, '0')} {posts.length === 1 ? 'NOTE' : 'NOTES'}</p>
      </header>

      <div class="ledger-list">
        {posts.map((post, index) => (
          <LedgerEntry post={post} readTime={estimateReadingTime(post.body ?? '')} index={index} />
        ))}
      </div>
    </section>

    <nav class="ledger-pathways" aria-label="继续浏览">
      <a href="/archive/">
        <span>02 / TIME</span>
        <strong>Archive</strong>
        <em>Browse the chronology.</em>
      </a>
      <a href="/tags/">
        <span>03 / TOPICS</span>
        <strong>Tags</strong>
        <em>Browse the knowledge index.</em>
      </a>
    </nav>
  </main>

  <SignalFooter />
</BaseLayout>
