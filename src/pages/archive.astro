---
import { getCollection } from 'astro:content'
import ArticleRow from '../components/ArticleRow.astro'
import SiteHeader from '../components/SiteHeader.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { estimateReadingTime } from '../lib/readingTime.mjs'

const posts = (await getCollection('posts', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---
<BaseLayout title="Archive — Glenn" description="Glenn 的全部公开文章归档。">
  <div class="page-shell inner-shell">
    <SiteHeader className="inner-topbar" />
    <main class="inner-page">
      <header class="inner-page-header register-header">
        <div>
          <p class="eyebrow">WRITING / COMPLETE REGISTER</p>
          <h1>Archive</h1>
        </div>
        <p class="register-summary">{posts.length} {posts.length === 1 ? 'published entry' : 'published entries'} · chronological</p>
      </header>
      <div class="index-register-head inner-register-head" aria-hidden="true">
        <span>DATE</span>
        <span>ENTRY</span>
        <span>FIELD / READ</span>
      </div>
      <div class="article-list publication-register">
        {posts.map(post => <ArticleRow post={post} readTime={estimateReadingTime(post.body ?? '')} />)}
      </div>
    </main>
    <footer class="inner-footer"><a href="/">← Home</a><a href="/tags/">Tags</a><a href="/rss.xml">RSS</a></footer>
  </div>
</BaseLayout>
