---
import { getCollection } from 'astro:content'
import SiteHeader from '../../components/SiteHeader.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { slugifyTag } from '../../lib/slug.mjs'

const posts = await getCollection('posts', ({ data }) => data.draft !== true)
const counts = new Map()
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1)
}
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]))
---
<BaseLayout title="Tags — Glenn" description="Glenn 博客的文章标签。">
  <div class="page-shell inner-shell">
    <SiteHeader className="inner-topbar" />
    <main class="inner-page">
      <header class="inner-page-header register-header">
        <div>
          <p class="eyebrow">INDEX / SUBJECTS</p>
          <h1>Tags</h1>
        </div>
        <p class="register-summary">{tags.length} subjects across {posts.length} published {posts.length === 1 ? 'entry' : 'entries'}.</p>
      </header>
      <div class="taxonomy-index" aria-label="文章主题索引">
        {tags.map(([tag, count], index) => (
          <a href={`/tags/${slugifyTag(tag)}/`}>
            <span class="taxonomy-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="taxonomy-name">{tag}</span>
            <small>{count} {count === 1 ? 'entry' : 'entries'}</small>
            <span class="taxonomy-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </main>
    <footer class="inner-footer"><a href="/">← Home</a><a href="/archive/">Archive</a><a href="/rss.xml">RSS</a></footer>
  </div>
</BaseLayout>
