---
import { getCollection } from 'astro:content'
import ArticleRow from '../../components/ArticleRow.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { estimateReadingTime } from '../../lib/readingTime.mjs'
import { slugifyTag } from '../../lib/slug.mjs'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true)
  const byTag = new Map()
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const list = byTag.get(tag) ?? []
      list.push(post)
      byTag.set(tag, list)
    }
  }
  return [...byTag.entries()].map(([tag, taggedPosts]) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      tag,
      posts: taggedPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    }
  }))
}

const { tag, posts } = Astro.props
---
<BaseLayout title={`${tag} — Glenn`} description={`Glenn 关于 ${tag} 的文章。`}>
  <div class="page-shell inner-shell">
    <SiteHeader className="inner-topbar" />
    <main class="inner-page">
      <header class="inner-page-header register-header">
        <div>
          <p class="eyebrow">SUBJECT / {tag}</p>
          <h1>{tag}</h1>
        </div>
        <p class="register-summary">{posts.length} {posts.length === 1 ? 'published entry' : 'published entries'} in this subject.</p>
      </header>
      <div class="index-register-head inner-register-head" aria-hidden="true">
        <span>DATE</span>
        <span>ENTRY</span>
        <span>FIELD / READ</span>
      </div>
      <div class="article-list publication-register">
        {posts.map(post => <ArticleRow post={post} readTime={estimateReadingTime(post.body ?? '')} />)}
      </div>
    </main>
    <footer class="inner-footer"><a href="/tags/">← All tags</a><a href="/archive/">Archive</a><a href="/">Home</a></footer>
  </div>
</BaseLayout>
