---
import { getCollection } from 'astro:content'
import LedgerEntry from '../../components/LedgerEntry.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SignalFooter from '../../components/SignalFooter.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { estimateReadingTime } from '../../lib/readingTime.mjs'
import { slugifyTag } from '../../lib/slug.mjs'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true)
  const byTag = new Map()
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const list = byTag.get(tag) ?? []
      list.push(post)
      byTag.set(tag, list)
    }
  }
  return [...byTag.entries()].map(([tag, taggedPosts]) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      tag,
      posts: taggedPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    }
  }))
}

const { tag, posts } = Astro.props
---
<BaseLayout title={`${tag} — Glenn`} description={`Glenn 关于 ${tag} 的文章。`}>
  <SiteHeader active="tags" />

  <main class="topic-detail-page">
    <header class="topic-detail-opening">
      <p class="signal-kicker">TOPIC / {tag}</p>
      <h1>{tag}</h1>
      <p>{posts.length} {posts.length === 1 ? 'entry' : 'entries'} in this topic.</p>
    </header>

    <section class="topic-detail-ledger" aria-label={`${tag} 文章`}>
      <div class="ledger-list">
        {posts.map((post, index) => (
          <LedgerEntry post={post} readTime={estimateReadingTime(post.body ?? '')} index={index} compact={true} />
        ))}
      </div>
    </section>

    <nav class="topic-detail-back" aria-label="返回主题索引">
      <a href="/tags/">← All topics</a>
    </nav>
  </main>

  <SignalFooter />
</BaseLayout>
