---
import SiteHeader from '../components/SiteHeader.astro'
import SignalFooter from '../components/SignalFooter.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="404 — Glenn" description="页面不存在。" noindex={true}>
  <SiteHeader />
  <main class="signal-error">
    <p class="signal-kicker">ERR / 404</p>
    <h1>Nothing here.</h1>
    <p>这个页面不存在，或者已经被移动。回到索引继续阅读。</p>
    <a href="/">Return to index →</a>
  </main>
  <SignalFooter />
</BaseLayout>
